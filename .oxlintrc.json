{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y", "vitest"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error"
  },
  "ignorePatterns": [
    ".next",
    "out",
    "storybook-static",
    "node_modules",
    ".claude",
    ".agents",
    ".venv",
    "docs/design/base44-prototype"
  ]
}
